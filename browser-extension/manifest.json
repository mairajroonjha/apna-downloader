{
  "manifest_version": 3,
  "name": "Apna Dowanloader",
  "version": "1.0",
  "description": "Integrates Chrome browser with Apna Dowanloader, providing right-click downloads and floating video buttons.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": "",
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
