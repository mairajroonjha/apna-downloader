{
  "name": "apna-downloader",
  "version": "1.0.0",
  "description": "High-performance segmented download manager for Windows and Mac",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Mairaj Ahmed",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.apnadownloader.app",
    "productName": "Apna Dowanloader",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "bin/**/*"
    ],
    "win": {
      "icon": "src/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "src/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apna Dowanloader"
    },
    "files": [
      "**/*",
      "!bin/**/*",
      "!browser-extension/**/*",
      "!browser-extension.crx",
      "!browser-extension.pem",
      "!dist/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!.git/**/*",
      "!scratch/**/*",
      "!*.md"
    ]
  }
}
